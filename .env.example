APP_NAME="Blue Education"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — sends enquiry notifications to admin
# Default "log" writes emails to storage/logs (safe for dev).
#
# Production uses Resend (https://resend.com — free tier: 3,000/mo, 100/day).
# Setup:
#   1. Create account, add domain "blueeducation.com.au" in Resend dashboard
#   2. Resend will show DNS records to add (SPF/DKIM/DMARC). Add at your DNS provider.
#   3. Generate an API key (Settings > API Keys), paste into RESEND_API_KEY below
#   4. Set MAIL_MAILER=resend
# DNS records Resend typically asks for (verify in their dashboard — your tokens differ):
#   TXT  send.blueeducation.com.au  "v=spf1 include:amazonses.com ~all"
#   TXT  resend._domainkey.blueeducation.com.au  "p=MIGfMA0GCSqG... (long DKIM key)"
#   MX   send.blueeducation.com.au  10 feedback-smtp.us-east-1.amazonses.com
#   TXT  _dmarc.blueeducation.com.au  "v=DMARC1; p=none;"
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@blueeducation.com.au"
MAIL_FROM_NAME="Blue Education"
RESEND_API_KEY=

# Contact-form routing — decoupled from the public-facing org email.
#   ENQUIRY_RECIPIENT goes in the To header.
#   ENQUIRY_CC is comma-separated.
ENQUIRY_RECIPIENT=sonia.ong@blueeducation.com.au
ENQUIRY_CC=info@blueeducation.com.au,jotham@cothink.ing

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

WHATSAPP_NUMBER=61411708899
TWITTER_HANDLE=@BlueEducationAU

# Site verification tokens — fill in when registering the property.
# Google: search.google.com/search-console → Add Property → URL-prefix → HTML tag method
# Bing:   bing.com/webmasters → Add a site → HTML Meta Tag method
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Google Tag Manager — public container ID (loads in the client).
# Leave blank in dev to skip injecting the GTM snippet.
GTM_CONTAINER_ID=

# PostHog — public project token (used client-side via GTM) plus the
# server-side capture toggle for unhandled exceptions.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_CAPTURE_EXCEPTIONS=false

VITE_APP_NAME="${APP_NAME}"
