# Search Console uses service-account auth. Invite the SA email as Owner on
# the verified property (Settings → Users and permissions).
GOOGLE_APPLICATION_CREDENTIALS=ga-credentials.json

# GTM uses OAuth Desktop auth (the GTM API does not accept service-account
# emails in User Management). Create an OAuth Client of type "Desktop app" in
# GCP Console → APIs & Services → Credentials, download the JSON, and save
# it next to .env as gtm-client-secrets.json.
GTM_CLIENT_SECRETS=gtm-client-secrets.json

# GTM container IDs — find in the URL: tagmanager.google.com/#/container/accounts/ACCOUNT_ID/containers/CONTAINER_ID
# Leave the numeric IDs blank and the setup script will auto-resolve from GTM_PUBLIC_ID.
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
GTM_PUBLIC_ID=GTM-PP6DRX6L

# Search Console verified property URL.
# Domain property:     sc-domain:blueeducation.com.au
# URL-prefix property: https://blueeducation.com.au/
GSC_SITE_URL=sc-domain:blueeducation.com.au

# PostHog — project token (public, safe in client JS).
POSTHOG_PROJECT_TOKEN=phc_pN7fpZKNzor5VLgZpHMiwRbM2H22c4zZ7G5MeudNq977
POSTHOG_HOST=https://us.i.posthog.com
