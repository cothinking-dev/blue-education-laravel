# Caddy reverse-proxy + automatic HTTPS for blueeducation.com.au.
#
# Install path on the server: /etc/caddy/Caddyfile
#
# Caddy auto-provisions Let's Encrypt certs. The redirect from www → apex below
# matches your apex-as-canonical decision.
#
# After install:
#   sudo systemctl reload caddy
#   sudo journalctl -u caddy -f

www.blueeducation.com.au {
    redir https://blueeducation.com.au{uri} 308
}

blueeducation.com.au {
    root * /home/deployer/blue-education-laravel/current/public

    encode zstd gzip

    # Long-cache static build assets (fingerprinted by Vite).
    @assets path /build/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Security headers.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    php_fastcgi unix//run/php/php8.5-fpm.sock
    file_server

    log {
        output file /var/log/caddy/blueeducation.access.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}
